    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated ERP user profile and assigned organizational role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["owner", "admin", "salesman", "production_supervisor", "accountant"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "phone": { "type": "string", "maxLength": 25 },
        "department": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "CompanySetting": {
      "title": "CompanySetting",
      "description": "Company profile, GSTIN, state code, and document numbering configuration.",
