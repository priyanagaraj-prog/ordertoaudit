      "required": ["invoiceNumber", "orderId", "orderNumber", "customerId", "customerName", "customerStateCode", "companyStateCode", "isInterState", "items", "subtotalPaisa", "cgstPaisa", "sgstPaisa", "igstPaisa", "totalTaxPaisa", "totalAmountPaisa", "paidAmountPaisa", "balanceDuePaisa", "paymentStatus", "dispatchStatus", "invoiceDate", "dueDate", "createdBy", "createdAt", "updatedAt"]
    },
    "Dispatch": {
      "title": "Dispatch",
      "description": "Finished goods dispatch record tied to a GST invoice and FEFO batch allocations.",
      "type": "object",
      "properties": {
        "dispatchNumber": { "type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invoiceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invoiceNumber": { "type": "string", "maxLength": 40 },
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 40 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "transporterName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "vehicleNumber": { "type": "string", "maxLength": 30 },
        "lrNumber": { "type": "string", "maxLength": 50 },
        "dispatchedItems": { "type": "array" },
        "status": { "type": "string", "enum": ["packed", "dispatched", "delivered"] },
        "dispatchedBy": { "type": "string", "maxLength": 128 },
        "dispatchedAt": { "type": "string", "maxLength": 60 },
        "deliveredAt": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dispatchNumber", "invoiceId", "invoiceNumber", "orderId", "orderNumber", "customerId", "customerName", "transporterName", "dispatchedItems", "status", "dispatchedBy", "createdAt", "updatedAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Customer payment receipt applied against a GST invoice.",
      "type": "object",
      "properties": {
        "receiptNumber": { "type": "string", "minLength": 3, "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invoiceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invoiceNumber": { "type": "string", "maxLength": 40 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "amountPaisa": { "type": "integer" },
        "paymentMode": { "type": "string", "enum": ["NEFT", "RTGS", "UPI", "Cheque", "Cash"] },
        "referenceNumber": { "type": "string", "maxLength": 80 },
        "paymentDate": { "type": "string", "maxLength": 40 },
        "notes": { "type": "string", "maxLength": 240 },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["receiptNumber", "invoiceId", "invoiceNumber", "customerId", "customerName", "amountPaisa", "paymentMode", "paymentDate", "recordedBy", "createdAt"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Immutable, traceable inventory ledger entry created transactionally on every stock mutation.",
      "type": "object",
      "properties": {
        "itemType": { "type": "string", "enum": ["raw_material", "packaging", "finished_good"] },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "itemCode": { "type": "string", "maxLength": 40 },
        "itemName": { "type": "string", "maxLength": 150 },
        "movementType": { "type": "string", "enum": ["PURCHASE_IN", "PRODUCTION_CONSUME", "PRODUCTION_OUT", "PRODUCTION_WASTAGE", "DISPATCH_OUT", "QC_REJECT", "ADJUSTMENT"] },
        "unit": { "type": "string", "maxLength": 24 },
        "beforeQty": { "type": "number" },
        "changeQty": { "type": "number" },
        "afterQty": { "type": "number" },
        "unitCostPaisa": { "type": "integer" },
        "totalValuePaisa": { "type": "integer" },
        "refType": { "type": "string", "maxLength": 40 },
        "refId": { "type": "string", "maxLength": 128 },
        "refNumber": { "type": "string", "maxLength": 60 },
        "batchNumber": { "type": "string", "maxLength": 50 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["itemType", "itemId", "itemCode", "itemName", "movementType", "unit", "beforeQty", "changeQty", "afterQty", "unitCostPaisa", "totalValuePaisa", "refType", "refId", "refNumber", "actorUid", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit trail for financial, stock, QC, order, and role actions.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 200 },
        "actorRole": { "type": "string", "maxLength": 40 },
        "action": { "type": "string", "minLength": 2, "maxLength": 80 },
        "entityType": { "type": "string", "minLength": 2, "maxLength": 60 },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 2, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorEmail", "actorRole", "action", "entityType", "entityId", "summary", "createdAt"]
    }
  },
